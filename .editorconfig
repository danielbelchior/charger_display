# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cpp,h,ino}]
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.{html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated from control-panel/index.html; keep it byte-identical.
[main/http_server_index.h]
trim_trailing_whitespace = false
insert_final_newline = unset
indent_size = unset
